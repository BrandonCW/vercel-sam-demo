# Deal Qualification System - Environment Variables Configuration
#
# Every variable below is validated by lib/env.ts. A missing or invalid required
# variable throws a descriptive error; there is no offline or local substitute.

# -----------------------------------------------------------------------------
# 1. Authentication Gate (Preview & Production)
# -----------------------------------------------------------------------------
# (required outside NODE_ENV=development) Shared password protecting the app gate.
# In local development (NODE_ENV === 'development') the gate is bypassed.
APP_PASSWORD=your-secure-app-password-here

# (required outside NODE_ENV=development) Secret for signing HMAC-SHA256 session tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-32-byte-base64-auth-secret-here

# -----------------------------------------------------------------------------
# 2. Simulated CRM Database (PostgreSQL / Neon)
# -----------------------------------------------------------------------------
# (required) Neon connection string (postgres:// or postgresql://). Tables are
# defined in db/schema.sql. Tests read the `test` branch URL from .env.test.local.
POSTGRES_URL=postgres://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/deal_qual_db?sslmode=require

# -----------------------------------------------------------------------------
# 3. Vercel AI Gateway (System 1 and System 2)
# -----------------------------------------------------------------------------
# (required) Vercel AI Gateway API key. All model calls route through the Gateway.
# Obtain from: Vercel Dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# Origin that serves the eve agent routes (/eve/v1/*). The /api/qualification/*
# routes call the agent here server-side; it is never derived from the request
# Host header. Bare origin, no path. Required locally. On Vercel it may be left
# unset: the platform-provided VERCEL_URL (each deployment's own URL, so preview
# deployments work) is used over https. If neither is set, requests fail loudly.
# Local: http://localhost:3000
EVE_AGENT_ORIGIN=http://localhost:3000

# Default System 2 model option when a request does not specify one.
# Vercel AI Gateway model ID for the eve agent and System 2 (see lib/models.ts).
# Defaults to anthropic/claude-sonnet-5. Supported: anthropic/claude-sonnet-5,
# anthropic/claude-haiku-4.5, openai/gpt-5.5, google/gemini-3.5-flash.
SYSTEM2_MODEL_ID=anthropic/claude-sonnet-5

# -----------------------------------------------------------------------------
# 4. Vercel Deployment Protection (required on Vercel while protection is on)
# -----------------------------------------------------------------------------
# Not set by you: Vercel exposes VERCEL_AUTOMATION_BYPASS_SECRET automatically once a
# Protection Bypass for Automation secret exists (Project Settings -> Deployment
# Protection). The /api/qualification routes send it as x-vercel-protection-bypass
# when calling this deployment's own /eve/v1; on Vercel without it they fail loudly.

# -----------------------------------------------------------------------------
# 5. Tests and evals only
# -----------------------------------------------------------------------------
# JEV_MODEL_ID overrides the typesafe-ai/jev evaluation model (provider/model). Only
# `pnpm eval` sets it, to an unknown model, for the Gateway-failure eval.
