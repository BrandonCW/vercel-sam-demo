# Deal Qualification System - Environment Variables Configuration

# -----------------------------------------------------------------------------
# 1. Authentication Gate (Preview & Production)
# -----------------------------------------------------------------------------
# Shared password protecting the application gate on Vercel Preview and Production.
# When running in local development (NODE_ENV === 'development'), the gate is automatically bypassed.
APP_PASSWORD=your-secure-app-password-here

# Secret key used for signing and verifying HMAC-SHA256 session tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-32-byte-base64-auth-secret-here

# -----------------------------------------------------------------------------
# 2. Simulated CRM Database (PostgreSQL / Neon)
# -----------------------------------------------------------------------------
# Neon connection string with pooled transaction support.
# Preview environment connects to the staging database branch.
# Production environment connects to the production database branch.
# If omitted, system falls back gracefully to in-memory state for development.
POSTGRES_URL=postgres://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/deal_qual_db?sslmode=require

# -----------------------------------------------------------------------------
# 3. System 2 Reasoning Engine & LLM Configuration
# -----------------------------------------------------------------------------
# Default model ID for System 2 deep reasoning.
# Options:
#   - claude-3-5-sonnet (Default)
#   - claude-3-5-haiku
#   - gpt-4o-mini
#   - gemini-2-flash
SYSTEM2_MODEL_ID=claude-3-5-sonnet

# Optional LLM Provider API Keys (used for live System 2 inference; deterministic offline fallback if unset)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EVE_API_KEY=
